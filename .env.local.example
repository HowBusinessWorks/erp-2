# Supabase — conexiunea directă la Postgres (Session pooler, port 5432)
# Se ia din Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.<ref>:<parola>@aws-0-<regiune>.pooler.supabase.com:5432/postgres"

# Supabase Storage — pentru fisiere si poze
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Parola tuturor conturilor din seed
SEED_PASSWORD="damina"
