# Supabase — conexiunea aplicatiei. TRANSACTION mode, portul 6543.
# Conexiunea se intoarce in bazin dupa fiecare tranzactie, deci incap multi clienti.
# Pe 5432 (session mode) plafonul e 15 si `next dev` il atinge singur: EMAXCONNSESSION.
DATABASE_URL="postgresql://postgres.<ref>:<parola>@aws-0-<regiune>.pooler.supabase.com:6543/postgres"

# Aceeasi baza, SESSION mode, portul 5432 — doar pentru `npm run db:push` si seed.
# drizzle-kit schimba schema si are nevoie de stare pe sesiune, pe care 6543 nu o pastreaza.
DIRECT_URL="postgresql://postgres.<ref>:<parola>@aws-0-<regiune>.pooler.supabase.com:5432/postgres"

# Supabase Storage — pentru fisiere si poze
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Parola tuturor conturilor din seed
SEED_PASSWORD="damina"
